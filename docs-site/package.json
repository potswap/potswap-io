{
  "name": "potswap-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Public developer documentation for Potswap (docs.potswap.io), built with Astro Starlight.",
  "scripts": {
    "dev": "node scripts/gen-llms.mjs && astro dev",
    "start": "astro dev",
    "gen-llms": "node scripts/gen-llms.mjs",
    "build": "node scripts/gen-llms.mjs && astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.2.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
